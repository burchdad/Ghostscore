# GhostScore Backend Configuration

# Environment
ENVIRONMENT=development

# Database - defaults to SQLite (ghostscore.db in root)
# SQLite requires NO setup, just works (perfect for family use)
DATABASE_URL=sqlite:///./ghostscore.db

# To use PostgreSQL instead, uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/ghostscore

# Optional: show SQL queries in console (debug)
SQL_ECHO=false

