# Frontend API endpoint (browser sees this)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Backend URL for Next.js rewrites (server-side)
# For devcontainer: 172.18.0.2:8000 (Docker network)
# For local development outside devcontainer: http://localhost:8000
BACKEND_URL=http://172.18.0.2:8000
# Plaid Integration (Bank Account Linking)
# Get these from https://dashboard.plaid.com
# Sign up for free at: https://plaid.com
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox

# Note: Server-side variables (no NEXT_PUBLIC_ prefix) are secure
# PLAID_SECRET and PLAID_CLIENT_ID never leave the server
# Use sandbox for development, switch to production when ready